# Nutri-MCP Configuration
# Copy this file to .env and fill in your values

# Transport: stdio (for Claude Code) or http (for web apps)
TRANSPORT=stdio

# HTTP port (only used if TRANSPORT=http)
HTTP_PORT=3000

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# USDA FoodData Central API Key (free)
# Get yours at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Nutritionix API (free tier available)
# Get yours at: https://developer.nutritionix.com/
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# Cache settings
CACHE_MAX_SIZE=1000
CACHE_TTL_MS=300000
