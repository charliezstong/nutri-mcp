# Nutri-MCP configuration (all optional). Copy to .env or pass via your MCP host.

# Transport: stdio (local MCP hosts) or http (Streamable HTTP on /mcp)
TRANSPORT=stdio
HTTP_PORT=3000
HTTP_HOST=127.0.0.1
# Browser origins allowed to call /mcp (comma-separated, * for any). Default: localhost only
ALLOWED_ORIGINS=

# Contact sent in the User-Agent, as Open Food Facts asks API users to identify themselves
OFF_CONTACT_EMAIL=
# https://world.openfoodfacts.net is the staging server
OFF_BASE_URL=https://world.openfoodfacts.org

# USDA FoodData Central (free): https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Nutritionix (paid; no public free tier): https://www.nutritionix.com/api
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# Feature switches (true/false)
ENABLE_USDA=true
ENABLE_NUTRITIONIX=true
ENABLE_RECALLS=true
ENABLE_CACHING=true

CACHE_MAX_SIZE=1000
REQUEST_TIMEOUT=10000

# debug, info, warn, error. Logs go to stderr; set LOG_FILE to also write a file
LOG_LEVEL=info
LOG_FILE=
